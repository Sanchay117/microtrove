# Copy to .env. Without a key the keeper only watches and logs what it would do.
KEEPER_PRIVATE_KEY=

# Optional overrides (defaults shown).
# RPC_URL=https://rpc.test.mezo.org
# POLL_SECONDS=30
# Skip liquidations that earn less than this, after gas, in MUSD.
# MIN_PROFIT_MUSD=0.01
# Most liquidations to send per scan.
# MAX_PER_TICK=10
# Pay queued vault withdrawals whenever idle MUSD can fill one.
# PROCESS_QUEUE=true
