# Copy to .env. Without a key the keeper only watches and logs what it would do.
KEEPER_PRIVATE_KEY=

# Optional overrides (defaults shown).
# RPC_URL=https://rpc.test.mezo.org
# POLL_SECONDS=30
# Skip liquidations that earn less than this, after gas, in MUSD.
# MIN_PROFIT_MUSD=0.01
# Most liquidations to send per scan.
# MAX_PER_TICK=10
# Pay queued vault withdrawals whenever idle MUSD can fill one.
# PROCESS_QUEUE=true

# Alerts for failed or unprofitable liquidations, failing scans and low gas.
# A Discord or Slack incoming webhook:
# ALERT_WEBHOOK_URL=
# And/or a Telegram bot:
# ALERT_TELEGRAM_BOT_TOKEN=
# ALERT_TELEGRAM_CHAT_ID=
# Warn when the keeper holds less BTC than this for gas.
# MIN_GAS_BTC=0.0002
# Scans that must fail in a row before an alert.
# FAILURE_ALERT_AFTER=3
# File that remembers sent alerts between runs, for cron-style hosting.
# STATE_FILE=.state.json
